---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import * as digitalGarden from '/Users/bhavaniravi/projects/til/start-here/how-i-built-my-digital-garden.md';

const posts = (await getCollection('notes')).sort(
	(a, b) => b.data.added.valueOf() - a.data.added.valueOf(),
);
function groupFilesByFolder(paths: string[]): Record<string, any> {
	// we will use this function later, for now we will use only top-level folders

    const grouped: Record<string, any> = {};

    // Iterate over each path
    for (const path of paths) {
        const segments = path.split('/');
        let current = grouped;

        // Traverse through each segment of the path and build the folder structure
        for (let i = 0; i < segments.length; i++) {
            const segment = segments[i];

            if (i === segments.length - 1) {
                // If it's the last segment, it represents a file, so add it to the current folder
                if (!current.files) {
                    current.files = [];
                }
                current.files.push(segment);
            } else {
                // If it's not the last segment, it represents a folder
                if (!current[segment]) {
                    current[segment] = {}; // Create folder if it doesn't exist
                }
                current = current[segment]; // Move deeper into the folder structure
            }
        }
    }

    return grouped;
}

// const groupedPosts = groupFilesByFolder(posts.map((post) => post.id));

function groupPostsByTopLevelFolder(posts) {
	const grouped: Record<string, any> = {};

	for (const post of posts) {
		const segments = post.id.split('/');
		const topLevelFolder = segments[0];

		if (!grouped[topLevelFolder]) {
			grouped[topLevelFolder] = [];
		}

		grouped[topLevelFolder].push(post);
	}

	return grouped;
}

const groupedPosts = groupPostsByTopLevelFolder(posts);

function convertSlugToTitle(slug: string): string {
	return slug
		.split('-')
		.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
		.join(' ');
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			nav {
				display: flex;
				overflow-y: scroll;
				max-height: 100vh;
				position: sticky;
				top: 0;
			}
			.nav-link:hover {
				font-weight: 500;
				text-decoration: none;
			}
			ul {
				display: block;
				margin: 2rem 1em;
				padding: 0;
				list-style-type: none;
			}
			ul li div a {
				display: flex;
				justify-content: space-between;
				text-decoration: none;
			}
			.title {
				margin: 0;
				/* color: rgb(var(--black)); */
				line-height: 0.5;

			}
			ul li a:hover h6,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			h6{
				font-size: 1em;
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div style={{ display: 'flex' }}>
		  {/* Left-side Navigation */}
		  <nav>
			<ul>
			  {
				Object.entries(groupedPosts).map(([folder, posts], index) => (
				  <li key={folder}>
					<a href={`#section-${folder}`} className="nav-link">
					  {convertSlugToTitle(folder)}
					</a>
				  </li>
				))
			  }
			</ul>
		  </nav>
		  <main>
			<h2>{digitalGarden.frontmatter.title}</h2>
			<digitalGarden.Content/>
			{
			  Object.entries(groupedPosts).map(([folder, posts], index) => (
				<section id={`section-${folder}`} key={folder}>
				  <h4 className="title">{convertSlugToTitle(folder)}</h4>
				  <ul>
					{
					  posts.map((post) => (
						<li key={post.id}>
						  <div>
							<a href={`/notes/${post.id}/`}>
							  <h6 className="title">{post.data.title}</h6>
							  <FormattedDate date={post.data.added} />
							</a>
						  </div>
						</li>
					  ))
					}
				  </ul>
				</section>
			  ))
			}
		  </main>
		</div>
	  
		<Footer />
	  </body>
	  
</html>
